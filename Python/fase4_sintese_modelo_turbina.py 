def plotar(res: dict, rotor: Rotor) -> None:
    """Gera todos os gráficos de análise."""

    # --- Gráfico 1: Cl/Cd vs alpha para cada Re ---
    fig1, axs1 = plt.subplots(1, len(RE_LIST), figsize=(5 * len(RE_LIST), 5), sharey=True)
    if len(RE_LIST) == 1:
        axs1 = [axs1]
    fig1.suptitle('Cl/Cd vs. Ângulo de Ataque (alpha) para diferentes Reynolds', fontsize=16)

    for j, Re in enumerate(RE_LIST):
        ax = axs1[j]
        for nome in PERFIS:
            pol = carregar_polar(nome, Re)
            razao = [cl / cd if cd > 0 else 0.0
                     for cl, cd in zip(pol.cl, pol.cd)]
            ax.plot(pol.alpha, razao, lw=1.4, label=nome)
        ax.axvline(0, color='k', lw=0.5)
        ax.set_title(f"Re = {Re:.0e}")
        ax.set_xlabel("alpha (graus)")
        if j == 0:
            ax.set_ylabel("Cl/Cd")
        ax.grid(alpha=0.3)
        ax.legend(fontsize=8)
    plt.tight_layout(rect=[0, 0, 1, 0.95])
    plt.show()

    # --- Gráfico 2: Cp_kin vs TSR (Re = 3e5) ---
    fig2, ax2 = plt.subplots(figsize=(10, 6))
    for nome in PERFIS:
        pol = carregar_polar(nome, 3.0e5)
        tsrs = np.linspace(1.0, 6.0, 50)
        cps = [cp_cinematica(pol, t, SIGMA_REF) for t in tsrs]
        ax2.plot(tsrs, cps, lw=1.6, label=nome)
    ax2.axvline(TSR_REF, ls="--", c="k", lw=0.8, label=f"TSR projeto = {TSR_REF}")
    ax2.set_title("Coeficiente de Potência Cinemático (Cp_kin) vs. TSR (Re = 3e5)", fontsize=16)
    ax2.set_xlabel("Tip Speed Ratio (TSR)")
    ax2.set_ylabel("Cp_kin")
    ax2.grid(alpha=0.3)
    ax2.legend(fontsize=10)
    plt.tight_layout()
    plt.show()

    # --- Gráfico 3: Barras — Cp_kin @ TSR 3.75, por Re ---
    fig3, ax3 = plt.subplots(figsize=(12, 7))
    x = np.arange(len(PERFIS))
    w = 0.2
    for j, Re in enumerate(RE_LIST):
        vals = [res[n][Re]["Cp_kin"] for n in PERFIS]
        ax3.bar(x + (j - 1) * w, vals, w, label=f"Re = {Re:.0e}")
        for i, val in enumerate(vals):
            ax3.text(x[i] + (j - 1) * w, val + 0.01, f'{val:.3f}',
                     ha='center', va='bottom', fontsize=8)
    ax3.set_xticks(x)
    ax3.set_xticklabels(PERFIS, rotation=25, ha='right', fontsize=10)
    ax3.set_ylabel("Cp_kin @ TSR 3.75")
    ax3.set_title("Comparação do Cp_kin por Perfil e Número de Reynolds (TSR = 3.75)", fontsize=16)
    ax3.grid(alpha=0.3, axis="y")
    ax3.legend(fontsize=10)
    plt.tight_layout()
    plt.show()

    # --- Gráfico 4: Potência entregue por perfil (tabela visual) ---
    fig4, ax4 = plt.subplots(figsize=(14, len(PERFIS) * 0.5 + 2))
    ax4.axis('off')
    ax4.set_title('Potência Entregue por Perfil (W) para diferentes velocidades (Cp escalado)',
                  fontsize=16)

    cp_kin_best = max(res[n][3.0e5]["Cp_kin"] for n in PERFIS)
    Vs_kmh = (10, 20, 30, 36, 50, 70)
    data = []
    column_headers = ["V (km/h)"] + PERFIS

    for v_kmh in Vs_kmh:
        row_data = [v_kmh]
        for nome in PERFIS:
            fator = res[nome][3.0e5]["Cp_kin"] / cp_kin_best
            P = rotor.potencia(v_kmh / 3.6, limitar=True, cp=CP_PROJ * fator)
            row_data.append(round(P, 0))
        data.append(row_data)

    df_power = pd.DataFrame(data, columns=column_headers)
    table = ax4.table(cellText=df_power.values, colLabels=df_power.columns,
                      loc='center', cellLoc='center')
    table.auto_set_font_size(False)
    table.set_fontsize(10)
    table.scale(1.2, 1.2)
    plt.tight_layout()
    plt.show()

    # --- Gráfico 5: Reynolds de corda em operação ---
    fig5, ax5 = plt.subplots(figsize=(10, 6))
    velocities_kmh = np.array([10.0, 36.0, 70.0])
    re_values = [rotor.re_corda(v / 3.6) for v in velocities_kmh]

    ax5.bar([f'{v} km/h' for v in velocities_kmh], re_values,
            color=['skyblue', 'lightcoral', 'lightgreen'])
    ax5.axhline(y=1.0e5, color='r', linestyle='--', label='Limite Inferior (1e5)')
    ax5.axhline(y=3.0e5, color='r', linestyle='--', label='Limite Superior (3e5)')

    ax5.set_title('Reynolds de Corda em Operação para Diferentes Velocidades', fontsize=16)
    ax5.set_xlabel('Velocidade do Vento')
    ax5.set_ylabel('Reynolds de Corda')
    ax5.ticklabel_format(style='sci', axis='y', scilimits=(0, 0))
    ax5.grid(axis='y', alpha=0.7)
    ax5.legend()
    plt.tight_layout()
    plt.show()


def plotar_comparacao_cl_alpha(res: dict) -> None:
    """Gráficos adicionais: Cl_max e alpha* por perfil e Reynolds."""

    cl_max_data = []
    alpha_star_data = []

    for nome in PERFIS:
        for Re in RE_LIST:
            polar_info = res[nome][Re]
            cl_max_data.append({'Perfil': nome, 'Re': Re, 'Cl_max': polar_info['Cl max']})
            alpha_star_data.append({'Perfil': nome, 'Re': Re,
                                    'alpha* (deg)': polar_info['alpha* (deg)']})

    df_cl_max = pd.DataFrame(cl_max_data)
    df_alpha_star = pd.DataFrame(alpha_star_data)

    # --- Gráfico 6: Cl_max por perfil e Reynolds ---
    fig_cl_max, ax_cl_max = plt.subplots(figsize=(12, 7))
    bar_width = 0.2
    index = np.arange(len(PERFIS))

    for i, Re in enumerate(RE_LIST):
        re_str = f'{Re:.0e}'
        cl_max_values = df_cl_max[df_cl_max['Re'] == Re]['Cl_max'].values
        ax_cl_max.bar(index + i * bar_width, cl_max_values, bar_width,
                      label=f'Re = {re_str}')
        for j, val in enumerate(cl_max_values):
            ax_cl_max.text(index[j] + i * bar_width, val + 0.01, f'{val:.2f}',
                           ha='center', va='bottom', fontsize=8)

    ax_cl_max.set_xlabel('Perfil')
    ax_cl_max.set_ylabel('Cl_max')
    ax_cl_max.set_title('Comparação de Coeficiente de Sustentação Máximo (Cl_max) '
                        'por Perfil e Reynolds')
    ax_cl_max.set_xticks(index + bar_width)
    ax_cl_max.set_xticklabels(PERFIS, rotation=25, ha='right')
    ax_cl_max.legend()
    ax_cl_max.grid(axis='y', linestyle='--', alpha=0.7)
    plt.tight_layout()
    plt.show()

    # --- Gráfico 7: alpha* por perfil e Reynolds ---
    fig_alpha_star, ax_alpha_star = plt.subplots(figsize=(12, 7))

    for i, Re in enumerate(RE_LIST):
        re_str = f'{Re:.0e}'
        alpha_star_values = df_alpha_star[df_alpha_star['Re'] == Re]['alpha* (deg)'].values
        ax_alpha_star.bar(index + i * bar_width, alpha_star_values, bar_width,
                          label=f'Re = {re_str}')
        for j, val in enumerate(alpha_star_values):
            ax_alpha_star.text(index[j] + i * bar_width, val + 0.01, f'{val:.1f}',
                               ha='center', va='bottom', fontsize=8)

    ax_alpha_star.set_xlabel('Perfil')
    ax_alpha_star.set_ylabel('alpha* (graus)')
    ax_alpha_star.set_title('Comparação de Ângulo de Ataque para Melhor Cl/Cd (alpha*) '
                            'por Perfil e Reynolds')
    ax_alpha_star.set_xticks(index + bar_width)
    ax_alpha_star.set_xticklabels(PERFIS, rotation=25, ha='right')
    ax_alpha_star.legend()
    ax_alpha_star.grid(axis='y', linestyle='--', alpha=0.7)
    plt.tight_layout()
    plt.show()


