# CONSTANTES
# ---------------------------------------------------------------------------
RHO_AIR = 1.225     # kg/m^3  (ar, nível do mar)
NU_AIR  = 1.46e-5   # m^2/s   (viscosidade cinemática ~15 °C)
CP_BETZ = 16.0 / 27.0

PERFIS      = ["NACA 0012", "NACA 0018", "NACA 0025", "SD7080"]
RE_LIST     = [1.0e5, 2.0e5, 3.0e5]
PASTA_POLAR = "polars"

TSR_REF   = 3.75    # TSR nominal de projeto
SIGMA_REF = 0.3     # solidez de projeto
CP_PROJ   = 0.48    # Cp de projeto (melhor perfil, conforme o manuscrito)


# ---------------------------------------------------------------------------
# 1) POLARES
# ---------------------------------------------------------------------------

@dataclass
class Polar:
    nome: str
    Re: float
    alpha: list[float]      # graus
    cl: list[float]
    cd: list[float]
    origem: str             # "xfoil" | "demo"

    def _interp(self, x: float, xs: list[float], ys: list[float]) -> float:
        """Interpolação linear; extrapolação constante nas bordas."""
        if x <= xs[0]:
            return ys[0]
        if x >= xs[-1]:
            return ys[-1]
        i = 0
        while i < len(xs) - 2 and x > xs[i + 1]:
            i += 1
        t = (x - xs[i]) / (xs[i + 1] - xs[i])
        return ys[i] + t * (ys[i + 1] - ys[i])

    def cl_cd(self, alpha_deg: float) -> tuple[float, float]:
        return (self._interp(alpha_deg, self.alpha, self.cl),
                self._interp(alpha_deg, self.alpha, self.cd))

    def resumo(self) -> dict:
        razao = [cl / cd if cd > 0 else 0.0
                 for cl, cd in zip(self.cl, self.cd)]
        i = razao.index(max(razao))
        return {"Cl/Cd max": max(razao),
                "alpha* (deg)": self.alpha[i],
                "Cl max": max(self.cl),
                "Cl em alpha*": self.cl[i]}


# --- Polares sintéticas de demonstração -----------------------------------
_DEMO = {
    "NACA 0012": dict(a0=0.105, ast=10.0, clmax=0.75, cd0=0.010, k=0.020),
    "NACA 0018": dict(a0=0.098, ast=12.5, clmax=0.90, cd0=0.011, k=0.022),
    "NACA 0025": dict(a0=0.090, ast=15.0, clmax=0.95, cd0=0.017, k=0.030),
    "SD7080"   : dict(a0=0.110, ast=13.0, clmax=1.05, cd0=0.009, k=0.018),
}


def _polar_demo(nome: str, Re: float) -> Polar:
    p = _DEMO[nome]
    f = 0.90 + 0.10 * math.log10(Re / 1.0e5) / math.log10(3.0)
    clmax = p["clmax"] * f
    alphas, cls, cds = [], [], []
    for a in [x * 0.5 for x in range(-40, 61)]:      # -20 a +30 graus
        if abs(a) <= p["ast"]:
            cl = p["a0"] * a
        elif a > p["ast"]:
            cl = clmax - (clmax - 0.4) * ((a - p["ast"]) / (20.0 - p["ast"]))
        else:
            cl = -clmax + (-0.4 + clmax) * ((a + p["ast"]) / (20.0 - p["ast"]))
        cd = p["cd0"] * f + p["k"] * cl * cl
        if abs(a) > p["ast"]:
            cd += 0.30 * ((abs(a) - p["ast"]) / 10.0) ** 2
        alphas.append(a)
        cls.append(cl)
        cds.append(cd)
    return Polar(nome, Re, alphas, cls, cds, origem="demo")


def _parse_xfoil(caminho: str, nome: str, Re: float) -> Polar:
    """Lê polar XFoil (cabeçalhos ignorados; usa as colunas alpha, CL, CD)
    ou CSV simples com 3 colunas numéricas."""
    alphas, cls, cds = [], [], []
    with open(caminho, "r", encoding="utf-8", errors="replace") as fh:
        for linha in fh:
            partes = linha.split()
            if len(partes) < 3:
                continue
            try:
                a = float(partes[0])
                cl = float(partes[1])
                cd = float(partes[2])
            except ValueError:
                continue
            alphas.append(a)
            cls.append(cl)
            cds.append(cd)
    if len(alphas) < 3:
        raise ValueError(f"polar sem dados suficientes: {caminho}")
    return Polar(nome, Re, alphas, cls, cds, origem="xfoil")


def carregar_polar(nome: str, Re: float, pasta: str = PASTA_POLAR) -> Polar:
    base = nome.replace(" ", "").replace("-", "")
    for ext in (".csv", ".txt", ".dat"):
        caminho = os.path.join(pasta, f"{base}_Re{int(Re)}{ext}")
        if os.path.exists(caminho):
            return _parse_xfoil(caminho, nome, Re)
    return _polar_demo(nome, Re)


