@dataclass
class Parametros:
    P_nominal: float = 1000.0   # W  (classe 500–1000)
    V_nominal: float = 10.0     # m/s ≈ 36 km/h
    Cp: float        = CP_PROJ
    N_pas: int       = 3
    AR: float        = 2.6      # H/D
    sigma: float     = SIGMA_REF
    TSR: float       = TSR_REF
    rho: float       = RHO_AIR
    nu: float        = NU_AIR

    def __post_init__(self) -> None:
        if not (500.0 <= self.P_nominal <= 1000.0):
            raise ValueError("P_nominal deve estar entre 500 e 1000 W.")
        if self.Cp >= CP_BETZ:
            raise ValueError(f"Cp deve ser menor que o limite de Betz "
                             f"({CP_BETZ:.3f}).")
        if self.AR <= 0 or self.sigma <= 0 or self.TSR <= 0:
            raise ValueError("AR, solidez e TSR devem ser positivos.")


@dataclass
class Rotor:
    D: float
    H: float
    c: float
    A: float
    P_nominal: float
    V_nominal: float
    Cp: float
    TSR: float
    rho: float
    nu: float

    @property
    def R(self) -> float:
        return self.D / 2.0

    def potencia(self, V: float, limitar: bool = True,
                 cp: float | None = None) -> float:
        cp = cp if cp is not None else self.Cp
        P = 0.5 * self.rho * self.A * V**3 * cp
        return min(P, self.P_nominal) if limitar else P

    def rpm(self, V: float) -> float:
        return (self.TSR * V / self.R) * 60.0 / (2.0 * math.pi)

    def re_corda(self, V: float, tsr: float | None = None) -> float:
        tsr = tsr if tsr is not None else self.TSR
        W = V * math.sqrt(tsr * tsr + 1.0)      # |W| médio característico
        return W * self.c / self.nu


def dimensionar(p: Parametros) -> Rotor:
    A = p.P_nominal / (0.5 * p.rho * p.V_nominal**3 * p.Cp)   # A = D·H
    D = math.sqrt(A / p.AR)                    # A = AR·D^2
    H = p.AR * D
    c = p.sigma * D / p.N_pas                  # sigma = N·c/D
    r = Rotor(D=D, H=H, c=c, A=A,
              P_nominal=p.P_nominal, V_nominal=p.V_nominal,
              Cp=p.Cp, TSR=p.TSR, rho=p.rho, nu=p.nu)
    assert math.isclose(r.c * p.N_pas / r.D, p.sigma, rel_tol=1e-9)
    assert math.isclose(r.H / r.D, p.AR, rel_tol=1e-9)
    return r


# ---------------------------------------------------------------------------
# 3) MODELO CINEMÁTICO (sem indução) — Cp relativo por perfil
# ---------------------------------------------------------------------------

def cp_cinematica(polar: Polar, tsr: float, sigma: float, n: int = 1440) -> float:
    """Cp estimado por perfil (ranking relativo — não usar como valor absoluto).
    Integração por soma de Riemann sobre [0, 2pi]."""
    soma = 0.0
    for i in range(n):
        th = 2.0 * math.pi * i / n
        w2 = 1.0 + tsr * tsr + 2.0 * tsr * math.sin(th)      # (W/V)^2
        alfa = math.degrees(math.atan2(math.cos(th), tsr + math.sin(th)))
        cl, cd = polar.cl_cd(alfa)
        ct = cl * math.sin(math.radians(alfa)) - cd * math.cos(math.radians(alfa))
        soma += w2 * ct
    return sigma * tsr * soma / n


def comparar_perfis(tsr_ref: float = TSR_REF, sigma: float = SIGMA_REF) -> dict:
    res = {}
    for nome in PERFIS:
        res[nome] = {}
        for Re in RE_LIST:
            pol = carregar_polar(nome, Re)
            r = pol.resumo()
            r["Cp_kin"] = cp_cinematica(pol, tsr_ref, sigma)
            r["fonte"] = pol.origem
            res[nome][Re] = r
    return res


